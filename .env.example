# GitHub personal access token (fine-grained, read:org + read:user scopes)
# Get at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Hunter.io API key (free tier = 25 searches/month, paid for more)
# Get at: https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_key_here

# Notion integration token + database ID
# Token: https://notion.so/my-integrations
# Database ID: open your DB in Notion, copy the ID from the URL
NOTION_TOKEN=your_notion_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
