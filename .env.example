# GitHub personal access token (fine-grained, read:org + read:user scopes)
# Get at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Hunter.io API key (free tier = 25 searches/month, paid for more)
# Get at: https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_key_here

# Notion integration token + database ID
# Token: https://notion.so/my-integrations
# Database ID: open your DB in Notion, copy the ID from the URL
NOTION_TOKEN=your_notion_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Anthropic API key for intelligence digest synthesis
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Notion page ID where daily digests will be created as child pages
# Open a page in Notion, copy the ID from the URL
NOTION_DIGEST_PAGE_ID=your_digest_parent_page_id_here

# Telegram bot delivery
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Send any message to your bot, then visit:
#    https://api.telegram.org/botYOUR_TOKEN/getUpdates
#    Copy the "id" value under "chat"
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
